package grupo6.proyectopoog6p2;

public abstract class ValidadorBase implements Validador {
    protected Validador siguiente;

    @Override
    public void setSiguiente(Validador siguiente) {
        this.siguiente = siguiente;
    }

    @Override
    public boolean validar(Object dato) {
        if (puedeValidar(dato)) {
            return siguiente != null ? siguiente.validar(dato) : true;
        }
        return false;
    }

    protected abstract boolean puedeValidar(Object dato);
}
